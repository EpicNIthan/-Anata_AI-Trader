RAW_EXTERNAL_EVENT_RETENTION_DAYS=1
RAW_TICK_RETENTION_DAYS=1
DIAGNOSTIC_RETENTION_DAYS=2
EXTERNAL_DATA_RETENTION_DAYS=365
TRAINING_FEATURE_RETENTION_DAYS=365
EXPERIENCE_RETENTION_DAYS=365
CLOSED_CANDLE_RETENTION_DAYS=365
ARCHIVE_DIR=./archives
# Required for admin/API access unless both dashboard credentials are set.
# Tokens in URL query strings are rejected; use a header or /admin/login.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
ADMIN_TOKEN=
LOG_LEVEL=INFO

# Anata V2 is paper-only. Automatic champion promotion stays disabled.
ANATA_V2_ENABLED=true
V2_USE_NARROW_MODELS=true
V2_REQUIRE_REGISTERED_CHAMPION=false
V2_AUTO_PROMOTE_CHAMPION=false
V2_CHAMPION_ACCOUNT_ID=champion
V2_DEFAULT_FORECAST_HORIZON_SECONDS=300
V2_SIGNAL_TTL_SECONDS=300
V2_MIN_NET_EDGE=0.0005
V2_MAX_POSITION_LEVERAGE=3
V2_MAX_SYMBOL_EXPOSURE_PCT=0.10
V2_MAX_GROSS_EXPOSURE_PCT=0.40
V2_MAX_NET_EXPOSURE_PCT=0.25
V2_MAX_CLUSTER_EXPOSURE_PCT=0.25
V2_MIN_LIQUIDITY_SCORE=0.20
V2_MAX_EXPECTED_COST_PCT=0.003
V2_EXTERNAL_CONTEXT_MAX_ADJUSTMENT=0.10
V2_CORRELATION_PENALTY_THRESHOLD=0.70
V2_SANDBOX_MAX_EXPOSURE_PCT=0.03
V2_MODEL_REGISTRY_DIR=./model_registry

# Independent pre-trade risk controls. Set the kill switch true to block exposure increases.
RISK_KILL_SWITCH_ENABLED=false
RISK_CONFIGURATION_VERSION=v2-safe-defaults
RISK_MAX_MARKET_DATA_AGE_SECONDS=180
RISK_MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
RISK_MAX_PORTFOLIO_LEVERAGE=3
RISK_MAX_SPREAD_PCT=0.005
RISK_MAX_EXPECTED_TRANSACTION_COST_PCT=0.003
RISK_MAX_FEE_EXPOSURE_PCT=0.01
RISK_REQUIRE_FRESH_DATA=true

# Deterministic simulation assumptions; these never connect to an exchange.
PAPER_SIMULATED_SPREAD_PCT=0.0002
PAPER_SIMULATED_SLIPPAGE_PCT=0.0001
PAPER_SIMULATED_LATENCY_MS=0
PAPER_SIMULATED_VOLUME_PARTICIPATION=0.10
PAPER_SIMULATED_PARTIAL_FILL_ENABLED=false
PAPER_SIMULATED_FUNDING_RATE=0
PAPER_SIMULATED_MARKET_IMPACT_COEFFICIENT=0
PAPER_SIMULATED_ORDER_TTL_SECONDS=300

# Optional news intelligence. The safe default uses local intelligence only.
EXTERNAL_AI_ENABLED=false
EXTERNAL_AI_PROVIDER_ORDER=generic
EXTERNAL_AI_DAILY_REQUEST_LIMIT=20
EXTERNAL_AI_MONTHLY_BUDGET_USD=0
