RISK_KILL_SWITCH_ENABLED=false
RISK_CONFIGURATION_VERSION=regime-pullback-v1-safe-defaults
RISK_MAX_MARKET_DATA_AGE_SECONDS=1800
RISK_MAX_PORTFOLIO_DRAWDOWN_PCT=0.15
RISK_MAX_PORTFOLIO_LEVERAGE=1
RISK_MAX_SPREAD_PCT=0.0008
RISK_MAX_EXPECTED_TRANSACTION_COST_PCT=0.003
RISK_MAX_FEE_EXPOSURE_PCT=0.01
