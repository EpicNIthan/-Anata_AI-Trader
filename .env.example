LOCAL_NEWS_STUDENT_VERSION=rule-v1
ENRICHMENT_ENABLED=true
ENRICHMENT_INTERVAL_SECONDS=300
ENRICHMENT_BATCH_SIZE=25

# Lightweight operational monitoring. Heavy research remains a local CLI workflow.
VISION_REFRESH_SECONDS=15
VISION_DEFAULT_LIMIT=250
MONITORING_ENABLED=true
MONITORING_OUTCOME_BATCH_SIZE=250
MONITORING_HEALTH_WINDOW=100
