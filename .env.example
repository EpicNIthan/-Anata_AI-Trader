# Safe example configuration for regime_pullback_v1.
# Never commit real credentials. Generate ADMIN_TOKEN separately for deployment.
APP_ENV=production
PORT=8000
DATABASE_URL=postgresql+psycopg://anata_user:fake_password@localhost:5432/anata_ai_trader
ADMIN_TOKEN=replace_with_a_generated_secure_token
LOG_LEVEL=INFO
WORKER_ROLE=all

# Hard safety boundary
TRADING_MODE=paper
LIVE_TRADING_ENABLED=false
AUTO_TRADER_ENABLED=true
STRATEGY_NAME=regime_pullback_v1
ENABLE_SERVER_TRAINING=false
ENABLE_SERVER_INFERENCE=false
AUTO_TRADER_USE_TRAINED_MODEL=false
ANATA_V2_ENABLED=false
EXPLORATION_MODE=false
PAPER_DATA_COLLECTION_MODE=false
EXTERNAL_AI_ENABLED=false
RESEARCH_ENABLED=false
RESEARCH_AUTO_PROMOTE=false

# Timeframes and symbols
MARKET_DATA_TIMEFRAME=1m
DECISION_TIMEFRAME=15m
REGIME_TIMEFRAME=1h
TRADING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_INTERVAL=1m
AUTO_TRADER_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
PAPER_TRADE_TIMEFRAME=15m
STRATEGY_POLL_INTERVAL_SECONDS=30
DECISION_CLOSE_GRACE_SECONDS=10

# Exact risk defaults
FIXED_LEVERAGE=1
RISK_PER_TRADE_PCT=0.25
MAX_SYMBOL_EXPOSURE_PCT=10
MAX_TOTAL_EXPOSURE_PCT=20
MAX_OPEN_POSITIONS=2
MAX_POSITIONS_PER_SYMBOL=1
MAX_TRADES_PER_SYMBOL_PER_DAY=3
MAX_TOTAL_TRADES_PER_DAY=8
DAILY_LOSS_LIMIT_PCT=1
MAX_CONSECUTIVE_LOSSES=3
COOLDOWN_BARS=8

# Signal filters
MIN_CONFIDENCE=0.75
ADX_MIN=20
ATR_PCT_MIN=0.0025
ATR_PCT_MAX=0.03
MAX_SPREAD_BPS=8
MAX_ABS_FUNDING_RATE=0.0005

# Stops and exits
ATR_STOP_MULTIPLIER=1.5
ATR_TAKE_PROFIT_MULTIPLIER=2.5
TRAILING_ATR_MULTIPLIER=1
BREAK_EVEN_AT_R=1
TRAILING_START_AT_R=1.5
TIME_EXIT_BARS=16
TIME_EXIT_MIN_R=0.5
STALE_DATA_SAFETY_TIMEOUT_MINUTES=60

# Conservative paper execution
PAPER_START_BALANCE=10000
PAPER_FEE_RATE_PER_SIDE=0.0004
PAPER_SLIPPAGE_RATE_PER_SIDE=0.0002
PAPER_ESTIMATED_SPREAD_BPS=4
PAPER_MIN_QUANTITY=0.000001
PAPER_QUANTITY_STEP=0.000001
PAPER_MIN_NOTIONAL=5
PAPER_LEVERAGE=1
PAPER_MIN_LEVERAGE=1
PAPER_MAX_LEVERAGE=1
PAPER_CONFIDENCE_LEVERAGE_ENABLED=false

# Decision and research records
STORE_ALL_DECISIONS=true
STORE_REJECTED_SIGNALS=true
STORE_SHADOW_DECISIONS=true
STORE_FEATURE_SNAPSHOTS=true
AUTO_BUILD_LABELS_ON_EXPORT=true

# Core collectors
ENABLE_MARKET_COLLECTOR=true
STORE_LIVE_CANDLE_UPDATES=true
STORE_MARKET_TICKS=false
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision

# Derivatives collector includes open interest, funding, and taker flow
DERIVATIVES_ENABLED=true
ENABLE_DERIVATIVES_COLLECTOR=true
DERIVATIVES_POLL_INTERVAL_SECONDS=300
DERIVATIVES_PERIOD=5m
DERIVATIVES_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com

# Context collectors
ENABLE_SPOT_CONTEXT_COLLECTOR=true
SPOT_CONTEXT_POLL_INTERVAL_SECONDS=300
SPOT_CONTEXT_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
ENABLE_NEWS_COLLECTOR=true
NEWS_PROVIDER=rss,gdelt
RSS_NEWS_ENABLED=true
RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml,https://cointelegraph.com/rss,https://decrypt.co/feed
RSS_REQUEST_USER_AGENT=AnataAITrader/1.0 RSS reader
GDELT_ENABLED=true
GDELT_POLL_INTERVAL_SECONDS=900
GDELT_MAX_RECORDS=20
NEWSAPI_ENABLED=false
NEWS_MOCK_FALLBACK_ENABLED=false
NEWS_QUERY=crypto OR bitcoin OR ethereum OR macro economy
NEWS_POLL_INTERVAL_SECONDS=120
ENABLE_HF_SENTIMENT=false
HF_SENTIMENT_BACKEND=api

ENABLE_FEAR_GREED_COLLECTOR=true
ENABLE_GLOBAL_MARKET_COLLECTOR=true
ENABLE_LIQUIDATION_COLLECTOR=true
ENABLE_STABLECOIN_RISK_COLLECTOR=true
ENABLE_MACRO_RISK_COLLECTOR=true
EXTERNAL_COLLECTOR_INTERVAL_SECONDS=300
LIQUIDATION_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
LIQUIDATION_ROLLUP_SECONDS=60
STORE_RAW_LIQUIDATIONS=false
STORE_RAW_EXTERNAL_EVENTS=false

# Railway-safe retention
RAILWAY_DATA_FACTORY_MODE=true
DATA_LIFECYCLE_INTERVAL_SECONDS=86400
OPERATIONAL_RETENTION_DAYS=2
RAW_PAYLOAD_RETENTION_HOURS=6
LIVE_UPDATE_RETENTION_HOURS=6
ACCOUNT_EQUITY_RETENTION_DAYS=30
RAW_NEWS_TEXT_RETENTION_DAYS=30
KEEP_CLOSED_CANDLES_DAYS=365
KEEP_TRAINING_FEATURES_DAYS=365
KEEP_EXPERIENCE_DAYS=365
RAW_NEWS_RETENTION_DAYS=30
RAW_EXTERNAL_EVENT_RETENTION_DAYS=7
RAW_TICK_RETENTION_DAYS=1
DIAGNOSTIC_RETENTION_DAYS=7
EXTERNAL_DATA_RETENTION_DAYS=365
TRAINING_FEATURE_RETENTION_DAYS=365
EXPERIENCE_RETENTION_DAYS=365
CLOSED_CANDLE_RETENTION_DAYS=365
ARCHIVE_DIR=./archives
MODEL_DIR=./models

# ---------------------------------------------------------------------------
# Preserved project-wide configuration (collectors, training, V2 compatibility,
# monitoring, optional external AI, and research). These remain documented even
# though regime_pullback_v1 is the only automatic trading strategy.
# ---------------------------------------------------------------------------
COINGECKO_DEMO_API_KEY=fake_coingecko_demo_key
NEWS_API_KEY=fake_news_api_key
NEWS_PROVIDER_URL=https://newsapi.org/v2/everything
NEWS_POLL_SECONDS=300
NEWS_SENTIMENT_MODEL=mrm8488/distilroberta-finetuned-financial-news-sentiment-analysis
HF_API_TOKEN=fake_huggingface_token
HF_API_TIMEOUT_SECONDS=20
MODEL_TYPE=local-uploaded
MODEL_TARGET=target_trade_quality_score
MODEL_MIN_ROWS=500
MODEL_ACTIVATION_MODE=manual
MODEL_MIN_DIRECTIONAL_ACCURACY=0.52
MODEL_MAX_TEST_DRAWDOWN=0.20
MODEL_REQUIRE_POSITIVE_NET_RETURN=true
TRAINING_MAX_ROWS=250000
TRAINING_TIMEOUT_SECONDS=900
TRAINING_CPU_SAFE_MODE=true
TRAINING_DISABLE_COLLECTORS_DURING_HEAVY_JOB=true
TRAINING_BACKGROUND_ONLY=true
ENABLE_STABLECOIN_COLLECTOR=true
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=replace_with_a_strong_password_or_use_admin_token
VISION_REFRESH_SECONDS=15
VISION_DEFAULT_LIMIT=250
MONITORING_ENABLED=true
MONITORING_OUTCOME_BATCH_SIZE=250
MONITORING_HEALTH_WINDOW=100
HEALTH_MIN_OBSERVATIONS=20
HEALTH_MIN_REFERENCE_OBSERVATIONS=10
HEALTH_WATCH_MIN_INFORMATION_COEFFICIENT=0
HEALTH_DEGRADED_MIN_INFORMATION_COEFFICIENT=-0.10
HEALTH_WATCH_MIN_NET_EXPECTANCY=0
HEALTH_DEGRADED_MIN_NET_EXPECTANCY=-0.001
HEALTH_WATCH_CALIBRATION_ERROR=0.25
HEALTH_DEGRADED_CALIBRATION_ERROR=0.40
HEALTH_WATCH_MISSING_FEATURE_RATE=0.10
HEALTH_DEGRADED_MISSING_FEATURE_RATE=0.25
HEALTH_WATCH_PREDICTION_DRIFT=0.25
HEALTH_DEGRADED_PREDICTION_DRIFT=0.50
HEALTH_WATCH_FEATURE_DRIFT=0.25
HEALTH_DEGRADED_FEATURE_DRIFT=0.50
HEALTH_WATCH_OOD_RATE=0.10
HEALTH_DEGRADED_OOD_RATE=0.25
HEALTH_OOD_ZSCORE_THRESHOLD=4
HEALTH_OOD_FEATURE_FRACTION=0.10
HEALTH_WATCH_LIVE_SHADOW_DIVERGENCE=0.30
HEALTH_DEGRADED_LIVE_SHADOW_DIVERGENCE=0.60
HEALTH_WATCH_TRANSACTION_COST_INCREASE=0.25
HEALTH_DEGRADED_TRANSACTION_COST_INCREASE=0.75
HEALTH_WATCH_CORRELATION_INCREASE=0.15
HEALTH_DEGRADED_CORRELATION_INCREASE=0.30
HEALTH_WATCH_REGIME_DEPENDENCE=0.70
HEALTH_DEGRADED_REGIME_DEPENDENCE=0.90
HEALTH_WATCH_CAPACITY_DECLINE=0.15
HEALTH_DEGRADED_CAPACITY_DECLINE=0.35
HEALTH_SUSPEND_CONSECUTIVE_ERRORS=5
RESEARCH_DATA_LAKE_DIR=./local_data
RESEARCH_REPORT_DIR=./research_reports
RESEARCH_SCHEDULER_INTERVAL_SECONDS=3600

# Retired Anata V2 execution remains disabled, but its registry/inspection values
# stay documented for backward compatibility with historical records and APIs.
V2_USE_NARROW_MODELS=false
V2_REQUIRE_REGISTERED_CHAMPION=false
V2_AUTO_PROMOTE_CHAMPION=false
V2_CHAMPION_ACCOUNT_ID=champion
V2_DEFAULT_FORECAST_HORIZON_SECONDS=300
V2_SIGNAL_TTL_SECONDS=300
V2_MIN_NET_EDGE=0.0005
V2_MAX_POSITION_LEVERAGE=1
V2_MAX_SYMBOL_EXPOSURE_PCT=0.10
V2_MAX_GROSS_EXPOSURE_PCT=0.20
V2_MAX_NET_EXPOSURE_PCT=0.20
V2_MAX_CLUSTER_EXPOSURE_PCT=0.20
V2_MIN_LIQUIDITY_SCORE=0.20
V2_MAX_EXPECTED_COST_PCT=0.003
V2_EXTERNAL_CONTEXT_MAX_ADJUSTMENT=0.10
V2_CORRELATION_PENALTY_THRESHOLD=0.70
V2_SANDBOX_MAX_EXPOSURE_PCT=0.03
V2_MODEL_REGISTRY_DIR=./model_registry

# Legacy independent-risk and simulator settings are retained for manual API and
