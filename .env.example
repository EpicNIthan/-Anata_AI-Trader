DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/anata_ai_trader
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,LTCUSDT
BINANCE_INTERVAL=1m
STORE_LIVE_CANDLE_UPDATES=true
STORE_MARKET_TICKS=false
BINANCE_REST_BASE_URL=https://data-api.binance.vision
BINANCE_WS_BASE_URL=wss://data-stream.binance.vision
BINANCE_FUTURES_REST_BASE_URL=https://fapi.binance.com
BINANCE_FUTURES_WS_BASE_URL=wss://fstream.binance.com
DERIVATIVES_ENABLED=true
ENABLE_DERIVATIVES_COLLECTOR=false
DERIVATIVES_POLL_INTERVAL_SECONDS=300
DERIVATIVES_PERIOD=5m
DERIVATIVES_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,LTCUSDT
ENABLE_FEAR_GREED_COLLECTOR=false
ENABLE_GLOBAL_MARKET_COLLECTOR=false
ENABLE_LIQUIDATION_COLLECTOR=false
ENABLE_STABLECOIN_COLLECTOR=false
ENABLE_STABLECOIN_RISK_COLLECTOR=false
ENABLE_MACRO_RISK_COLLECTOR=false
EXTERNAL_COLLECTOR_INTERVAL_SECONDS=300
LIQUIDATION_SYMBOLS=BTCUSDT,ETHUSDT
LIQUIDATION_ROLLUP_SECONDS=60
STORE_RAW_LIQUIDATIONS=false
STORE_RAW_EXTERNAL_EVENTS=false
COINGECKO_DEMO_API_KEY=
NEWS_API_KEY=
NEWS_PROVIDER=rss,gdelt,newsapi
RSS_NEWS_ENABLED=true
RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/?outputType=xml,https://cointelegraph.com/rss,https://decrypt.co/feed
RSS_REQUEST_USER_AGENT=AnataAITrader/1.0 RSS reader
GDELT_ENABLED=true
GDELT_POLL_INTERVAL_SECONDS=900
GDELT_MAX_RECORDS=20
NEWSAPI_ENABLED=false
NEWS_PROVIDER_URL=https://newsapi.org/v2/everything
NEWS_QUERY=crypto OR bitcoin OR ethereum OR macro economy
NEWS_POLL_SECONDS=300
NEWS_POLL_INTERVAL_SECONDS=120
NEWS_MOCK_FALLBACK_ENABLED=false
NEWS_SENTIMENT_MODEL=mrm8488/distilroberta-finetuned-financial-news-sentiment-analysis
ENABLE_HF_SENTIMENT=false
HF_SENTIMENT_BACKEND=api
HF_API_TOKEN=
HF_API_TIMEOUT_SECONDS=20
PAPER_START_BALANCE=10000
MODEL_DIR=./models
TRADING_MODE=paper
ENABLE_SERVER_TRAINING=false
ENABLE_SERVER_INFERENCE=true
MODEL_TYPE=local-uploaded
MODEL_TARGET=target_trade_quality_score
AUTO_BUILD_LABELS_ON_EXPORT=true
MODEL_MIN_ROWS=500
MODEL_ACTIVATION_MODE=manual
MODEL_MIN_DIRECTIONAL_ACCURACY=0.52
MODEL_MAX_TEST_DRAWDOWN=0.20
MODEL_REQUIRE_POSITIVE_NET_RETURN=true
TRAINING_MAX_ROWS=250000
TRAINING_TIMEOUT_SECONDS=900
TRAINING_CPU_SAFE_MODE=true
TRAINING_DISABLE_COLLECTORS_DURING_HEAVY_JOB=true
TRAINING_BACKGROUND_ONLY=true
ENABLE_MARKET_COLLECTOR=false
ENABLE_NEWS_COLLECTOR=false
AUTO_TRADER_ENABLED=false
AUTO_TRADER_USE_TRAINED_MODEL=false
AUTO_TRADER_INTERVAL_SECONDS=60
AUTO_TRADER_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,LTCUSDT
PAPER_TRADE_TIMEFRAME=1m
PAPER_FEE_RATE=0.0004
PAPER_LEVERAGE=3
PAPER_MIN_LEVERAGE=1
PAPER_MAX_LEVERAGE=3
PAPER_CONFIDENCE_LEVERAGE_ENABLED=false
RISK_MAX_TRADE_SIZE_PCT=0.10
RISK_MAX_ENTRY_FEE_PCT_OF_EQUITY=0.01
RISK_MAX_DAILY_LOSS_PCT=0.05
RISK_MAX_OPEN_POSITIONS=3
RISK_MIN_CONFIDENCE=0.55
RISK_COOLDOWN_MINUTES=30
STRATEGY_MIN_EDGE_AFTER_FEES=0.001
AUTO_CLOSE_MIN_NET_PROFIT_PCT=0.001
AUTO_MIN_HOLD_SECONDS=900
AUTO_TAKE_PROFIT_MIN_HOLD_SECONDS=0
AUTO_MAX_HOLD_SECONDS=14400
AUTO_POSITION_MAX_LOSS_PCT=0.10
AUTO_DEFAULT_STOP_LOSS_PCT=0.01
AUTO_DEFAULT_TAKE_PROFIT_PCT=0.02
AUTO_FAST_PROFIT_EXIT_PCT=0.006
EXPLORATION_MODE=false
EXPLORATION_RATE=0.05
MIN_PAPER_TRADE_NOTIONAL=50
RAILWAY_DATA_FACTORY_MODE=true
DATA_LIFECYCLE_INTERVAL_SECONDS=86400
OPERATIONAL_RETENTION_DAYS=2
RAW_PAYLOAD_RETENTION_HOURS=6
LIVE_UPDATE_RETENTION_HOURS=6
ACCOUNT_EQUITY_RETENTION_DAYS=2
RAW_NEWS_TEXT_RETENTION_DAYS=3
KEEP_CLOSED_CANDLES_DAYS=365
KEEP_TRAINING_FEATURES_DAYS=365
KEEP_EXPERIENCE_DAYS=365
