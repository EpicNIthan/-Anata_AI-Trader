HEALTH_DEGRADED_PREDICTION_DRIFT=0.50
HEALTH_WATCH_FEATURE_DRIFT=0.25
HEALTH_DEGRADED_FEATURE_DRIFT=0.50
HEALTH_WATCH_OOD_RATE=0.10
HEALTH_DEGRADED_OOD_RATE=0.25
HEALTH_OOD_ZSCORE_THRESHOLD=4
